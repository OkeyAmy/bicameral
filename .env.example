# ---------------------------------------------------------------------------
# Bicameral — environment
#
# Nothing about the market universe belongs in here. No asset list, no cadence,
# no pool address, no marketId. Those are discovered at runtime from the venue.
# `pnpm discover` and `pnpm preflight` both run with this file empty.
# ---------------------------------------------------------------------------

# Needed only for writes and for the indexer path. Read-only scripts run without it.
PRIVATE_KEY=

# Somnia Shannon testnet (chain 50312). Both RPCs serve the same chain.
RPC_URL=https://dream-rpc.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Somnia Agents platform (Shannon testnet).
SOMNIA_AGENTS=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776

# Read these off https://agents.testnet.somnia.network — they are not in the docs.
LLM_INFERENCE_AGENT_ID=
JSON_API_AGENT_ID=

# Filled in after deploy.
FACTORY_ADDRESS=
TREASURY_ADDRESS=

# Keeper safety: true logs what it would do and sends nothing.
DRY_RUN=true
